# Models: any OpenAI-compatible endpoint. Crusoe Serverless Inference for the demo.
LLM_BASE_URL=https://api.inference.crusoecloud.com/v1
LLM_API_KEY=
LLM_PROVIDER_LABEL=Crusoe
# Exact IDs from GET $LLM_BASE_URL/models
MODEL_FAST=deepseek-ai/Deepseek-V4-Flash
MODEL_WRITER=zai-org/GLM-5.3
MODEL_VISION=Qwen/Qwen3.8-27B
# USD per million tokens "input,output" for the cost counter (Crusoe list prices; Qwen3.8 27B is an estimate)
PRICE_FAST=0.14,0.28
PRICE_WRITER=1.40,4.40
PRICE_VISION=0.30,1.83

# Voiceover
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=tpS5zOAgWUiQMhzYbG2h

# Band (optional; without it the crew runs over an in-process room)
BAND_ENABLED=1
BAND_USER_KEY=
# Filled in by `pnpm band:setup`: BAND_HUMAN_ID, BAND_HUMAN_HANDLE, BAND_<ROLE>_ID, BAND_<ROLE>_KEY

# Rendering
# RENDER_FPS=30
# RENDER_WORKERS=3
